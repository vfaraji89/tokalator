{
  "name": "tokalator",
  "displayName": "Tokalator",
  "description": "Open-source context engineering for AI coding assistants: real-time context budget, tab relevance, model pricing, and workspace security for Copilot, Claude, and other agents.",
  "version": "4.1.1",
  "publisher": "vfaraji89",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/vfaraji89/tokalator"
  },
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.99.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "keywords": [
    "tokens",
    "context",
    "context-engineering",
    "ai",
    "copilot",
    "claude",
    "tokalator",
    "calculator",
    "open-source"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "tokalator",
          "title": "Tokalator",
          "icon": "media/tokalator.svg"
        }
      ]
    },
    "views": {
      "tokalator": [
        {
          "type": "webview",
          "id": "tokalator.dashboard",
          "name": "Token Budget"
        }
      ]
    },
    "chatParticipants": [
      {
        "id": "tokalator.tokens",
        "name": "tokalator",
        "fullName": "Tokalator",
        "description": "Count and manage your AI context token budget",
        "isSticky": false,
        "commands": [
          {
            "name": "count",
            "description": "Show current token count and budget status"
          },
          {
            "name": "optimize",
            "description": "Close low-relevance tabs to free up tokens"
          },
          {
            "name": "pin",
            "description": "Pin a file so it's always included"
          },
          {
            "name": "breakdown",
            "description": "Show where your tokens are going"
          },
          {
            "name": "instructions",
            "description": "List, count, and estimate tokens for instruction files in workspace"
          },
          {
            "name": "model",
            "description": "Show or switch the active AI model"
          },
          {
            "name": "unpin",
            "description": "Unpin a file so it returns to normal relevance scoring"
          },
          {
            "name": "reset",
            "description": "Reset session state (chat turn counter)"
          },
          {
            "name": "compaction",
            "description": "Show per-turn token growth and compaction recommendations"
          },
          {
            "name": "preview",
            "description": "Preview token cost of your next message before sending"
          },
          {
            "name": "secure",
            "description": "Scan workspace security and auto-generate AI agent settings"
          },
          {
            "name": "skill-gen",
            "description": "Auto-generate a SKILL.md from project analysis"
          },
          {
            "name": "settings-gen",
            "description": "Generate GitHub and VS Code AI settings files"
          },
          {
            "name": "exit",
            "description": "End the current session and save summary"
          },
          {
            "name": "codemap",
            "description": "Generate GLOSSARY.md and SITE-MAP.md for agents"
          },
          {
            "name": "pricewatch",
            "description": "Show model pricing changes, cost impact analysis, and rate change history"
          }
        ]
      }
    ],
    "commands": [
      {
        "command": "tokalator.refresh",
        "title": "Refresh Token Count",
        "category": "Tokalator",
        "icon": "$(refresh)"
      },
      {
        "command": "tokalator.optimize",
        "title": "Optimize (Close Low-Relevance Tabs)",
        "category": "Tokalator",
        "icon": "$(sparkle)"
      },
      {
        "command": "tokalator.clearPins",
        "title": "Clear All Pinned Files",
        "category": "Tokalator"
      },
      {
        "command": "tokalator.refreshPricing",
        "title": "Refresh Pricing Catalog",
        "category": "Tokalator",
        "icon": "$(cloud-download)"
      },
      {
        "command": "tokalator.secure",
        "title": "Secure Workspace",
        "category": "Tokalator",
        "icon": "$(shield)"
      },
      {
        "command": "tokalator.feedback",
        "title": "Tokalator: Send Feedback"
      },
      {
        "command": "tokalator.telemetryShow",
        "title": "Tokalator: Show Telemetry Data"
      },
      {
        "command": "tokalator.telemetryExport",
        "title": "Tokalator: Export My Telemetry Data"
      },
      {
        "command": "tokalator.telemetryDelete",
        "title": "Tokalator: Delete My Telemetry Data"
      },
      {
        "command": "tokalator.codeMaps",
        "title": "Tokalator: Generate Code Maps (GLOSSARY.md, SITE-MAP.md)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "tokalator.refresh",
          "when": "view == tokalator.dashboard",
          "group": "navigation"
        },
        {
          "command": "tokalator.optimize",
          "when": "view == tokalator.dashboard",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Tokalator",
      "properties": {
        "tokalator.relevanceThreshold": {
          "type": "number",
          "default": 0.3,
          "minimum": 0,
          "maximum": 1,
          "description": "Tabs below this relevance score are marked as distractors (0-1)"
        },
        "tokalator.windowSize": {
          "type": "number",
          "default": 0,
          "description": "Override context window size in tokens. Set to 0 (default) to use the selected model's window."
        },
        "tokalator.model": {
          "type": "string",
          "default": "claude-opus-5-5",
          "enum": [
            "claude-fable-5-1",
            "claude-mythos-5-1",
            "claude-fable-5",
            "claude-mythos-5",
            "claude-opus-5-5",
            "claude-opus-5",
            "claude-opus-4.8",
            "claude-opus-4.7",
            "claude-opus-4.6",
            "claude-opus-4.5",
            "claude-sonnet-5-5",
            "claude-sonnet-5",
            "claude-sonnet-4.6",
            "claude-haiku-5-5",
            "claude-haiku-4.5",
            "gpt-6-astra",
            "gpt-6.1-sol",
            "gpt-6-luna",
            "gpt-5.6-sol",
            "gpt-5.6-terra",
            "gpt-5.6-luna",
            "gpt-5.5",
            "gpt-5.4",
            "gpt-5.4-mini",
            "gpt-5.4-nano",
            "gpt-5.3-codex",
            "gemini-3.8-flash",
            "gemini-3.6-flash",
            "gemini-3.5-flash",
            "gemini-3.1-pro-preview",
            "gemini-3-flash-preview",
            "gemini-2.5-pro"
          ],
          "enumDescriptions": [
            "Claude Fable 5.1 — 1M tokens — $10.00/$50.00 per MTok",
            "Claude Mythos 5.1 — 1M tokens — $10.00/$50.00 per MTok",
            "Claude Fable 5 — 1M tokens — $10.00/$50.00 per MTok",
            "Claude Mythos 5 — 1M tokens — $10.00/$50.00 per MTok",
            "Claude Opus 5.5 — 1M tokens — $4.00/$20.00 per MTok",
            "Claude Opus 5 — 1M tokens — $5.00/$25.00 per MTok",
            "Claude Opus 4.8 — 1M tokens — $5.00/$25.00 per MTok",
            "Claude Opus 4.7 — 1M tokens — $5.00/$25.00 per MTok",
            "Claude Opus 4.6 — 1M tokens — $5.00/$25.00 per MTok",
            "Claude Opus 4.5 — 200K tokens — $5.00/$25.00 per MTok",
            "Claude Sonnet 5.5 — 1M tokens — $2.00/$10.00 per MTok",
            "Claude Sonnet 5 — 1M tokens — $2.00/$10.00 per MTok",
            "Claude Sonnet 4.6 — 1M tokens — $3.00/$15.00 per MTok",
            "Claude Haiku 5.5 — 1M tokens — $0.100/$0.500 per MTok",
            "Claude Haiku 4.5 — 200K tokens — $1.00/$5.00 per MTok",
            "GPT-6 Astra — 1.05M tokens — $10.00/$50.00 per MTok",
            "GPT-6.1 Sol — 1.05M tokens — $2.00/$10.00 per MTok",
            "GPT-6 Luna — 1.05M tokens — $0.100/$0.500 per MTok",
            "GPT-5.6 Sol — 1.05M tokens — $4.00/$20.00 per MTok",
            "GPT-5.6 Terra — 1.05M tokens — $2.00/$12.00 per MTok",
            "GPT-5.6 Luna — 1.05M tokens — $0.200/$1.20 per MTok",
            "GPT-5.5 — 1.05M tokens — $5.00/$30.00 per MTok",
            "GPT-5.4 — 1.05M tokens — $2.50/$15.00 per MTok",
            "GPT-5.4 mini — 400K tokens — $0.750/$4.50 per MTok",
            "GPT-5.4 nano — 400K tokens — $0.200/$1.25 per MTok",
            "GPT-5.3-Codex — 400K tokens — $1.75/$14.00 per MTok",
            "Gemini 3.8 Flash — 1.05M tokens — $0.750/$3.75 per MTok",
            "Gemini 3.6 Flash — 1.05M tokens — $0.750/$3.75 per MTok",
            "Gemini 3.5 Flash — 1.05M tokens — $1.50/$9.00 per MTok",
            "Gemini 3.1 Pro — 1.05M tokens — $2.00/$12.00 per MTok",
            "Gemini 3 Flash — 1.05M tokens — $0.500/$3.00 per MTok",
            "Gemini 2.5 Pro — 1.05M tokens — $1.25/$10.00 per MTok"
          ],
          "description": "AI model to calculate context budget against"
        },
        "tokalator.autoRefreshInterval": {
          "type": "number",
          "default": 2000,
          "description": "Dashboard refresh interval in milliseconds"
        },
        "tokalator.enableSessionLogging": {
          "type": "boolean",
          "default": false,
          "description": "Enable opt-in session logging for research studies. Logs only aggregate counts and scores — no file names or contents."
        },
        "tokalator.claudeCode.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show token usage and cost from local Claude Code session logs (CLI and VS Code extension) for this workspace. Reads ~/.claude/projects (or CLAUDE_CONFIG_DIR) on this machine; nothing is uploaded."
        },
        "tokalator.telemetry.enabled": {
          "type": "boolean",
          "default": false,
          "tags": [
            "usesOnlineServices",
            "telemetry"
          ],
          "markdownDescription": "Share anonymous daily usage counts (feature use, model IDs, Claude Code totals) with tokalator.ai to improve the extension. Off by default. Never includes code, file names, paths, or prompts. Also requires VS Code telemetry to be on. Use **Tokalator: Show Telemetry Data** to see exactly what is sent and **Tokalator: Delete My Telemetry Data** to erase it. [Privacy policy](https://tokalator.ai/privacy#telemetry)"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "esbuild ./src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --sourcemap",
    "watch": "esbuild ./src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --sourcemap --watch",
    "generate-models": "npx tsx scripts/generate-models.ts",
    "package": "npm run compile && npx @vscode/vsce package --no-dependencies",
    "lint": "eslint src",
    "test": "jest --verbose",
    "preview:dashboard": "npx tsx scripts/render-dashboard-preview.ts",
    "test:e2e": "npm run compile && node e2e/run.js"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^24.12.0",
    "@types/vscode": "^1.99.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.14",
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "@anthropic-ai/tokenizer": "^0.0.4",
    "js-tiktoken": "^1.0.21"
  },
  "homepage": "https://tokalator.ai",
  "author": "Vahid Farajijobehdar"
}
