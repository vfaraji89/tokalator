// Opt-in, anonymous extension telemetry and in-editor survey answers.
// No file names, paths, prompts, or code are stored.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model TelemetryDay {
  id            String   @id @default(cuid())
  installId     String
  day           String
  extVersion    String
  vscodeVersion String
  platform      String
  payload       Json
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([installId, day])
  @@index([day])
}

model FeedbackAnswer {
  id         String   @id @default(cuid())
  installId  String
  question   String
  answer     String
  extVersion String
  createdAt  DateTime @default(now())

  @@index([question])
  @@index([installId])
}
