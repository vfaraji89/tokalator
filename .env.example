# .env.example — Required environment variables for Tokalator
# Copy to .env and fill in values. NEVER commit .env files.

# ── AI Provider Keys (for wiki content generation) ──
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=

# ── Database (for Prisma, optional — web platform only) ──
DATABASE_URL=

# ── VS Code Extension (use SecretStorage API, not env vars) ──
# Extension secrets are stored via vscode.SecretStorage at runtime.
# Do NOT place extension API keys here.

# ── Deployment ──
VERCEL_TOKEN=
